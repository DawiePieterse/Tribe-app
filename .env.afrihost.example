# Copy to ".env" in tribe/ on Afrihost (next to app/ and public/) and fill in the blanks.
# Database: cPanel > Database Wizard (names start with the account prefix, bowlsbg5n9w0_).
# APP_KEY: php artisan key:generate --show (cPanel > Terminal, in the tribe folder).
# Mail: create the mailbox tribe@bowlsbuddy.co.za in cPanel > Email Accounts; its
# "Connect Devices" page shows the server and port.

APP_NAME=Tribe
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://tribe.bowlsbuddy.co.za
APP_TIMEZONE=Africa/Johannesburg
APP_LOCALE=af
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=single
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=bowlsbg5n9w0_tribe
DB_USERNAME=bowlsbg5n9w0_tribe
DB_PASSWORD=

# Logins are remembered on each device; the session itself can stay short.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

MAIL_MAILER=smtp
MAIL_HOST=mail.bowlsbuddy.co.za
MAIL_PORT=465
MAIL_SCHEME=smtps
MAIL_USERNAME=tribe@bowlsbuddy.co.za
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="tribe@bowlsbuddy.co.za"
MAIL_FROM_NAME=Tribe

# "Stuur na Tribe" reads plans out of chat messages with Claude when a key is set
# (console.anthropic.com); without one a simpler built-in reader is used.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Two-way calendar sync (Meer › Kalenders). Leave empty to offer only iCloud. Redirect URIs:
# <APP_URL>/kalenders/koppel/google/terug and <APP_URL>/kalenders/koppel/outlook/terug
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# Shopping-list items link to a Checkers and a Woolworths search; %s is the search words.
# An empty address leaves that shop's button out.
CHECKERS_SEARCH_URL="https://www.checkers.co.za/search?Search=%s"
WOOLWORTHS_SEARCH_URL="https://www.woolworths.co.za/browse?searchterm=%s&fr=1"

# Push notifications: `php artisan tribe:vapid-keys` prints these two. Empty: no notifications.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

TRIBE_HOUSEHOLD="Oupa en Ouma"
TRIBE_ADMIN_NAME=Oupa
TRIBE_ADMIN_EMAIL=
