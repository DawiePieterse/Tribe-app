APP_NAME=Tribe
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Africa/Johannesburg
APP_LOCALE=af
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tribe
DB_USERNAME=tribe
DB_PASSWORD=tribe

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="tribe@bowlsbuddy.co.za"
MAIL_FROM_NAME=Tribe

# First install (php artisan db:seed): the first household and its admin.
# "Stuur na Tribe" reads plans out of chat messages with Claude when a key is set
# (console.anthropic.com); without one a simpler built-in reader is used.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

TRIBE_HOUSEHOLD="Oupa en Ouma"
TRIBE_ADMIN_NAME=Oupa
TRIBE_ADMIN_EMAIL=
# Local only: made-up demo family instead.
TRIBE_DEMO=false
